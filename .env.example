# ==========================================
# Digital Movie Releases - Environment Config
# ==========================================

# TMDB API Key (Free tier from https://www.themoviedb.org/settings/api)
# Used for official digital premiere dates, original titles, backdrops, and popularity score.
TMDB_API_KEY=

# Optional Telegram Notifications (configured in GitHub Secrets or locally)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone for log outputs and display (default: UTC)
APP_TIMEZONE=UTC

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
